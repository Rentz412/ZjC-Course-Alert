<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_glass_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:minHeight="48dp"
            android:gravity="center_vertical" android:contentDescription="@string/widget_open">
            <TextView style="@style/WidgetCaption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ZjC  /  华珠课表" android:textColor="@color/widget_accent" android:letterSpacing="0.04" />
            <TextView android:id="@+id/widget_title" style="@style/WidgetText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/widget_agenda_title"
                android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_date" style="@style/WidgetText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="@font/instrument_serif"
            android:textSize="36sp" android:text="—" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/widget_refresh" style="@style/WidgetNavigation" android:layout_width="40dp"
            android:layout_height="48dp" android:layout_marginStart="8dp" android:text="↻"
            android:textSize="24sp" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_subtitle" style="@style/WidgetCaption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="10dp"
        android:text="@string/widget_agenda_loading" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="0dp"
            android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent" />
        <TextView android:id="@+id/widget_empty" style="@style/WidgetText" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center_vertical"
            android:padding="12dp" android:lineSpacingExtra="4dp" android:background="@drawable/widget_course_bg"
            android:text="@string/widget_agenda_loading" />
    </FrameLayout>
    <TextView android:id="@+id/widget_footer" style="@style/WidgetCaption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="@string/widget_agenda_hint" android:textSize="10sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_previous" style="@style/WidgetNavigation" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_previous" />
        <TextView android:id="@+id/widget_today_action" style="@style/WidgetNavigation" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="6dp"
            android:text="@string/widget_today_action" android:textStyle="bold" />
        <TextView android:id="@+id/widget_next" style="@style/WidgetNavigation" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_next" />
    </LinearLayout>
</LinearLayout>
